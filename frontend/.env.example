# Copy to .env.local for local dev. Never commit real keys.

# Claude API (server only). Defaults to claude-sonnet-5-5 when the model is empty
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# For a local demo without a key, against `npm run stand-in`. Set the key above to not-real.
# ANTHROPIC_BASE_URL=http://127.0.0.1:4310

# Supabase (Project Settings > API). The publishable key is safe in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server only, no NEXT_PUBLIC_ prefix). The route runs the quota and writes the
# history with it, and refuses to run without it. For the local stack: supabase status
SUPABASE_SECRET_KEY=

# Optional. Set to off to rewrite without style references, as the public site should until the
# corpus rights are reviewed (docs/DEPLOY.md)
STYLE_REFERENCES=
